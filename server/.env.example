# Copie este arquivo para ".env" (na mesma pasta) e preencha com o seu token.
#
# Como conseguir o token de teste do Mercado Pago:
#   1. Crie uma conta em https://www.mercadopago.com.br/developers
#   2. No painel, vá em "Suas integrações" -> "Criar aplicação"
#   3. Escolha "Pagamentos online" como o produto a integrar
#   4. Na página da aplicação, aba "Credenciais de teste", copie o
#      "Access Token" — pode vir como "TEST-..." ou como "APP_USR-...":
#      contas mais novas do Mercado Pago usam o prefixo "APP_USR-" mesmo
#      para o token de teste (o painel confirma isso na própria página).
#
# Nunca coloque esse token em código versionado nem no front-end: ele dá
# poder de criar e consultar cobranças na conta do Mercado Pago.

MP_ACCESS_TOKEN=TEST-substitua-pelo-seu-token-aqui

# Deixe "true" (padrão) enquanto testa com token de conta de teste: o
# Mercado Pago aprova automaticamente qualquer Pix cujo pagador se chame
# "APRO" — é um valor mágico só de sandbox. Troque para "false" quando for
# usar um token de produção de verdade, senão esse nome falso vai junto
# como pagador em cobranças reais.
MP_SANDBOX=true

# Porta única do site, da API e do WebSocket.
PORT=3001

# Apresentação do grupo: R$1 no InfiniteTap; confia no retorno local do app.
# Não é verificação bancária independente. Desativado por padrão.
TAP_DEMO_ENABLED=false

# Celular fixo InfiniteTap: chave aleatória de 64 caracteres hexadecimais.
# Configure a mesma chave no backend e no aparelho; nunca publique no Git.
TAP_TERMINAL_KEY=
TAP_TERMINAL_HANDLE=

# Assistente administrativo. Padrão sem chamadas a modelos.
# rules: cálculos, gráficos e dicas do sistema; ollama-cloud: IA sob demanda.
# Consulte IA-ADMINISTRATIVA.md antes de ativar.
AI_PROVIDER=rules

# Cloud: chaves apenas no servidor. AI_ADMIN_KEY deve ter no mínimo 16 caracteres,
# ser diferente da chave Ollama e ser entregue apenas ao dono do estabelecimento.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b
AI_ADMIN_KEY=
AI_DAILY_CALL_LIMIT=5
AI_CACHE_MINUTES=60
# Opcional: caminho em disco persistente para o contador de tentativas.
# Sem disco persistente, reinícios/deploys no Render Free podem zerar o contador.
# AI_USAGE_FILE=/caminho-persistente/ai-usage.json

# Alternativa local: AI_PROVIDER=ollama, Ollama instalado no computador do backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
