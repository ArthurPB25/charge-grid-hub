# Copie este arquivo para ".env" (na mesma pasta) e preencha com o seu token.
#
# Como conseguir o token de teste do Mercado Pago:
#   1. Crie uma conta em https://www.mercadopago.com.br/developers
#   2. No painel, vá em "Suas integrações" -> "Criar aplicação"
#   3. Escolha "Pagamentos online" como o produto a integrar
#   4. Na página da aplicação, aba "Credenciais de teste", copie o
#      "Access Token" — pode vir como "TEST-..." ou como "APP_USR-...":
#      contas mais novas do Mercado Pago usam o prefixo "APP_USR-" mesmo
#      para o token de teste (o painel confirma isso na própria página).
#
# Nunca coloque esse token em código versionado nem no front-end: ele dá
# poder de criar e consultar cobranças na conta do Mercado Pago.

MP_ACCESS_TOKEN=TEST-substitua-pelo-seu-token-aqui

# Deixe "true" (padrão) enquanto testa com token de conta de teste: o
# Mercado Pago aprova automaticamente qualquer Pix cujo pagador se chame
# "APRO" — é um valor mágico só de sandbox. Troque para "false" quando for
# usar um token de produção de verdade, senão esse nome falso vai junto
# como pagador em cobranças reais.
MP_SANDBOX=true

# Porta única do site, da API e do WebSocket.
PORT=3001

# Assistente de Operação: IA local, sem chave ou cobrança de API.
# Instale o Ollama no mesmo computador do backend e baixe este modelo.
# AI_PROVIDER=rules desativa a IA e mantém os relatórios por regras.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
